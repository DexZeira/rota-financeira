VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Somente demonstracao local; sandbox requer adapter/backend ainda nao implementados.
VITE_OPEN_FINANCE_MODE=disabled

# Pluggy Integration
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
OPEN_FINANCE_OAUTH_REDIRECT_URI=https://SEU-DOMINIO/open-finance/callback
SUPABASE_SERVICE_ROLE_KEY=

OPEN_FINANCE_REAL_ENABLED=false
OPEN_FINANCE_ENV=sandbox

# Manio + Google Sheets Integration
# Service Account credentials - STORE THESE IN SUPABASE SECRETS ONLY, never in frontend
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# Optional: enable/disable the Manio integration
MANIO_SHEETS_ENABLED=true
# Backend only: explicit frontend origins allowed to call the Manio Functions.
MANIO_SHEETS_ALLOWED_ORIGINS=https://SEU-DOMINIO
