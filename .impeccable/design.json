      "name": "Superfície de conteúdo",
      "kind": "card",
      "refersTo": "card",
      "description": "Agrupamento reutilizável com borda tonal e hierarquia compacta.",
      "html": "<section class=\"ds-card\" aria-label=\"Resumo de exemplo\"><h2 class=\"ds-card-title\">Seus registros</h2><p class=\"ds-card-text\">Consulte o período e a origem de cada movimento.</p><div class=\"ds-card-detail\"><span>Formato de apresentação</span><strong>Real brasileiro · BRL</strong></div></section>",
      "css": ".ds-card{max-width:380px;padding:24px;border:1px solid var(--border,#dce5dc);border-radius:var(--radius-surface,14px);background:var(--surface-default,var(--card,#fff));color:var(--foreground,#18332c);font-family:var(--font-ui,Manrope,'Segoe UI',sans-serif)}.ds-card-title{margin:0 0 8px;font-size:16px;font-weight:750;letter-spacing:-.025em}.ds-card-text{margin:0 0 20px;font-size:14px;line-height:1.55;color:var(--muted-foreground,#56675e)}.ds-card-detail{display:grid;gap:6px;font-size:12px;color:var(--muted-foreground,#56675e)}.ds-card-detail strong{font-size:15px;color:var(--foreground,#18332c);font-weight:750}@media(max-width:767px){.ds-card{padding:20px 16px}}"
    },
