      "css": ".ds-brand{display:inline-flex;align-items:center;gap:10px;font-family:var(--font-ui,Manrope,'Segoe UI',sans-serif);color:var(--foreground,#18332c);line-height:1.15}.ds-symbol{width:40px;height:40px;flex-shrink:0;color:var(--primary,#245e4d)}.ds-wordmark{font-size:20px;font-weight:800;letter-spacing:-.035em}.ds-brand-subtitle{display:block;font-size:14px;font-weight:500;letter-spacing:0}"
