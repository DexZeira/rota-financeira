      "css": ".ds-button-secondary{font-family:var(--font-ui,Manrope,'Segoe UI',sans-serif);font-size:14px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border-radius:var(--radius-control,8px);cursor:pointer;transition:background var(--duration,180ms) var(--ease-standard,cubic-bezier(.2,0,0,1)),color var(--duration,180ms),transform var(--duration-fast,120ms);border:1px solid var(--border,#dce5dc);background:var(--card,#fff);color:var(--foreground,#18332c)}.ds-button-secondary:hover:not(:disabled){background:var(--muted,#eaf0e9)}.ds-button-secondary:focus-visible{outline:2px solid var(--ring,#17634f);outline-offset:3px}.ds-button-secondary:active:not(:disabled){transform:translateY(1px)}.ds-button-secondary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none}}"
