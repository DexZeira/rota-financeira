      "html": "<label class=\"ds-field\">Nome do registro<input class=\"ds-input\" type=\"text\" value=\"Transporte\" /></label>",
      "css": ".ds-field{display:grid;gap:8px;font-family:var(--font-ui,Manrope,'Segoe UI',sans-serif);font-size:13px;color:var(--foreground,#18332c);max-width:320px}.ds-input{width:100%;min-width:0;min-height:46px;padding:11px 12px;border:1px solid var(--input,#a6b7af);border-radius:var(--radius-control,8px);background:var(--card,#fff);color:var(--foreground,#18332c);font-family:inherit;font-size:16px;caret-color:var(--primary,#245e4d)}.ds-input:hover{border-color:var(--border-strong,#a2b3ac)}.ds-input:focus-visible{outline:2px solid var(--ring,#17634f);outline-offset:3px}.ds-input:disabled{opacity:.5}"
    },
    {
      "name": "Navegação de sidebar",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Destino ativo lima sobre base petróleo.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navegação de exemplo\"><a class=\"ds-nav-item\" href=\"#dashboard\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg>Dashboard</a><a class=\"ds-nav-item\" href=\"#transacoes\">Transações</a></nav>",
      "css": ".ds-nav{display:grid;gap:4px;padding:12px;background:var(--sidebar,#143d35);width:224px;border-radius:var(--radius-surface,14px);font-family:var(--font-ui,Manrope,'Segoe UI',sans-serif)}.ds-nav-item{display:flex;align-items:center;gap:12px;min-height:44px;padding:10px 12px;border-radius:8px;color:var(--sidebar-foreground,#b8d0c5);font-size:13px;font-weight:500;text-decoration:none;transition:background 180ms,color 180ms}.ds-nav-item[aria-current]{background:var(--sidebar-accent,#d6edaa);color:var(--sidebar-accent-foreground,#213b28);font-weight:750}.ds-nav-item:hover:not([aria-current]){background:#ffffff0d;color:#f3f8ef}.ds-nav-item:focus-visible{outline:2px solid var(--sidebar-ring,#a9cdbf);outline-offset:3px}.ds-nav-item:active{transform:translateY(1px)}@media(prefers-reduced-motion:reduce){.ds-nav-item{transition:none}}"
    },
