  "components": [
    {
      "name": "Botão principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ação principal de um formulário ou registro.",
      "html": "<button type=\"button\" class=\"ds-button-primary\">Salvar alterações</button>",
      "css": ".ds-button-primary{font-family:var(--font-ui,Manrope,'Segoe UI',sans-serif);font-size:14px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border-radius:var(--radius-control,8px);cursor:pointer;transition:background var(--duration,180ms) var(--ease-standard,cubic-bezier(.2,0,0,1)),color var(--duration,180ms),transform var(--duration-fast,120ms);border:1px solid transparent;background:var(--primary,#245e4d);color:var(--primary-foreground,#fff)}.ds-button-primary:hover:not(:disabled){opacity:.86}.ds-button-primary:focus-visible{outline:2px solid var(--ring,#17634f);outline-offset:3px}.ds-button-primary:active:not(:disabled){transform:translateY(1px)}.ds-button-primary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}"
    },
    {
      "name": "Botão secundário",
      "kind": "button",
      "refersTo": "button-secondary",
