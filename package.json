{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-pwa.mjs",
    "check:edge": "deno check supabase/functions/**/*.ts",
    "check:supabase": "supabase check",
    "format": "oxfmt",
    "lint": "oxlint",
    "test": "node tests/run.mjs",
    "test:rls": "node tests/run.mjs --compile-only && node tests/supabase-live.mjs",
    "test:market-live": "node scripts/market-live.mjs",
    "build:e2e": "tsc --noEmit && vite build --mode e2e && node scripts/build-pwa.mjs .test-output/e2e-dist",
    "test:e2e": "npm run build:e2e && playwright test",
    "verify": "npm test && npm run lint && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "^19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.2.8",
    "react-pluggy-connect": "^2.12.0",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  },
  "type": "module"
}
